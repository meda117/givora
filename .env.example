# ============================================================
# GIVORA — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ============================================================

# ----------------------------------------------------------------
# NEXT.JS
# ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Givora

# ----------------------------------------------------------------
# FIREBASE — CLIENT (Public — safe to expose)
# Get these from Firebase Console → Project Settings → Your Apps
# ----------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ----------------------------------------------------------------
# FIREBASE — ADMIN SDK (Server-side only — NEVER expose to client)
# Get these from Firebase Console → Project Settings → Service Accounts
# Option A: JSON key file path (recommended for local dev)
# Option B: Individual fields (recommended for production env vars)
# ----------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
# Private key — keep the \n newlines, wrap the whole value in quotes in .env.local
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ----------------------------------------------------------------
# IMAGEKIT — Media Management
# Get these from ImageKit Dashboard → Developer Options
# ----------------------------------------------------------------
# Public Key — safe to expose to client for upload authentication request
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
# URL Endpoint — safe to expose (it's just the base URL)
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# Private Key — SERVER-SIDE ONLY, never expose to client
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key

# ----------------------------------------------------------------
# TRANSLATION API
# Supported providers: 'gemini' | 'openai' | 'google' | 'deepl' | 'none'
# When set to 'gemini' or 'openai', content is translated with
# natural Egyptian Arabic dialect & luxury brand tone.
# When set to 'none', auto-translation uses mock fallback.
# ----------------------------------------------------------------
TRANSLATION_PROVIDER=none

# Gemini API (Recommended for authentic Egyptian dialect translation)
GEMINI_API_KEY=your_gemini_api_key

# OpenAI API (Alternative LLM translation)
OPENAI_API_KEY=your_openai_api_key

# Google Cloud Translation API
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key
GOOGLE_TRANSLATE_PROJECT_ID=your_gcp_project_id

# DeepL API (Alternative)
DEEPL_API_KEY=your_deepl_api_key
DEEPL_API_URL=https://api-free.deepl.com

# ----------------------------------------------------------------
# FIREBASE CLOUD MESSAGING (Push Notifications)
# ----------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key_for_web_push

# ----------------------------------------------------------------
# SECURITY
# ----------------------------------------------------------------
# A strong random secret for signing session tokens, etc.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_secret_here

# Admin setup — first Super Admin email (used during initial setup)
INITIAL_ADMIN_EMAIL=admin@givora.com
