rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
         exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) ||
         request.auth.token.role in ['super_admin', 'product_manager', 'order_manager', 'content_manager']);
    }

    function isSuperAdmin() {
      return isAuthenticated() && 
        ((exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin') ||
         (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'super_admin') ||
         request.auth.token.role == 'super_admin');
    }

    // Public readable catalogs (Products, Categories, Homepage, Banners, Settings, Shipping)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homepage_sections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /website_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shipping_zones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /website_pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /customization_forms/{formId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews: Public can read approved reviews, customers can submit, admin can moderate
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Orders: Customers read their own; Admins read/update all
    match /orders/{orderId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if true; // Allows guest checkout
      allow update, delete: if isAdmin();
    }

    // Customers: Only the customer themselves or an admin can access
    match /customers/{customerId} {
      allow read, write: if isOwner(customerId) || isAdmin();
    }

    // User Profile
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Coupons: Public can read active coupons; Only Admin writes
    match /coupons/{couponId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    // Admin Users and RBAC: Super Admin only
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    match /admin_users/{adminId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }
  }
}
